# 数据库配置
DATABASE_URL=file:./data/dev.db

# OSS 配置
OSS_REGION=your-region
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=your-access-key
OSS_ACCESS_KEY_SECRET=your-secret-key
OSS_ENDPOINT=your-endpoint
# 生产 CDN 读 metadata 时常用：
# OSS_ENDPOINT=https://cn.windfonts.com
# OSS_FOLDER=fonts-packages/metadata
# OSS_METADATA_FILE=font-analysis.json,font-mapping.json
# 重建 font-analysis / mapping 并上传 OSS 后递增，逼 CDN 换缓存键
OSS_METADATA_VERSION=20260926hccq2

# NextAuth 配置
NEXTAUTH_URL=http://localhost:4000
NEXTAUTH_SECRET=your-secret-key-here
# 生产也可用 AUTH_SECRET（与 NEXTAUTH_SECRET 二选一）

# 管理员配置（Credentials，运营后台兜底）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password-here
ADMIN_EMAIL=admin@example.com

# 顾客 SSO：薇晓朵 WP OAuth Server（sso.weixiaoduo.com）
# 回调须登记为 {NEXTAUTH_URL}/api/auth/callback/weixiaoduo
WEIXIAODUO_OAUTH_ISSUER=https://sso.weixiaoduo.com
WEIXIAODUO_OAUTH_CLIENT_ID=
WEIXIAODUO_OAUTH_CLIENT_SECRET=
